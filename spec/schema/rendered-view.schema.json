{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-spatial/spec/v2/rendered-view.schema.json",
  "title": "RenderedViewAsset",
  "description": "Overlay schema for kind=rendered-view assets. Extends asset.schema.json.",
  "type": "object",
  "required": ["version", "asset_id", "kind", "representations", "workflow"],
  "properties": {
    "version": { "type": "string", "const": "2.0" },
    "asset_id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "const": "rendered-view" },
    "name": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "representations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["format", "uri"],
        "properties": {
          "rep_id": { "type": "string" },
          "format": {
            "type": "string",
            "enum": ["png", "jpeg", "png-depth"]
          },
          "uri": { "type": "string" },
          "mime_type": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "image_width": { "type": "integer", "minimum": 1 },
          "image_height": { "type": "integer", "minimum": 1 },
          "viewpoint_id": { "type": "string" },
          "depth_scale": { "type": "number", "exclusiveMinimum": 0 },
          "depth_unit": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "viewpoints": { "type": "array" },
    "render_hints": { "type": "object" },
    "workflow": {
      "type": "object",
      "required": ["target_asset_id", "viewpoint_id"],
      "properties": {
        "step": { "type": "string" },
        "target_asset_id": { "type": "string", "minLength": 1 },
        "viewpoint_id": { "type": "string", "minLength": 1 },
        "tool": { "type": "string" },
        "tool_version": { "type": "string" },
        "parameters": { "type": "object" },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "derived_from": { "type": "array", "items": { "type": "string" } },
    "spatial": { "type": "object" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
