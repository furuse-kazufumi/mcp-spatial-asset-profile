{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-spatial/spec/v2/segmentation-mask-3d.schema.json",
  "title": "SegmentationMask3DAsset",
  "description": "Overlay schema for kind=segmentation-mask-3d assets.",
  "type": "object",
  "required": ["version", "asset_id", "kind", "representations", "workflow"],
  "properties": {
    "version": { "type": "string", "const": "2.0" },
    "asset_id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "const": "segmentation-mask-3d" },
    "name": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "representations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["format", "uri"],
        "properties": {
          "rep_id": { "type": "string" },
          "format": { "type": "string", "enum": ["npy", "npz", "json-pc"] },
          "uri": { "type": "string" },
          "mime_type": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "point_count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "workflow": {
      "type": "object",
      "required": ["target_asset_id"],
      "properties": {
        "step": { "type": "string" },
        "target_asset_id": { "type": "string", "minLength": 1 },
        "source_masks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "correspondence": { "type": "string" },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "integer", "minimum": 0 },
              "name": { "type": "string" },
              "color": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0, "maximum": 255 },
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "tool": { "type": "string" },
        "tool_version": { "type": "string" },
        "parameters": { "type": "object" },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "derived_from": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
